{
  "name": "anyinb",
  "displayName": "AnyINB Notebook",
  "description": "Notebook for Python, JavaScript, SQL, HTTP, shell, and database workflows in VS Code.",
  "version": "1.0.0",
  "publisher": "xenon-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/tingirikar/anyinb-vscode-extension.git"
  },
  "homepage": "https://github.com/tingirikar/anyinb-vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/tingirikar/anyinb-vscode-extension/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Notebooks",
    "Programming Languages",
    "Education",
    "Data Science"
  ],
  "keywords": [
    "notebook",
    "interactive",
    "python",
    "javascript",
    "typescript",
    "go",
    "rust",
    "java",
    "c",
    "cpp",
    "sql",
    "mysql",
    "mongodb",
    "redis",
    "postgresql",
    "sqlite",
    "bash",
    "powershell",
    "http",
    "rest",
    "practice",
    "anyinb"
  ],
  "activationEvents": [
    "onNotebook:anyinb"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mysql",
        "aliases": [
          "MySQL",
          "mysql"
        ],
        "extensions": [
          ".sql",
          ".mysql"
        ]
      },
      {
        "id": "postgres",
        "aliases": [
          "PostgreSQL",
          "postgres"
        ],
        "extensions": [
          ".sql",
          ".psql"
        ]
      },
      {
        "id": "sqlite",
        "aliases": [
          "SQLite",
          "sqlite"
        ],
        "extensions": [
          ".sql",
          ".sqlite"
        ]
      },
      {
        "id": "redis",
        "aliases": [
          "Redis",
          "redis"
        ],
        "extensions": [
          ".redis"
        ]
      },
      {
        "id": "graphql",
        "aliases": [
          "GraphQL",
          "graphql"
        ],
        "extensions": [
          ".graphql",
          ".gql"
        ]
      },
      {
        "id": "websocket",
        "aliases": [
          "WebSocket",
          "websocket"
        ],
        "extensions": [
          ".ws"
        ]
      },
      {
        "id": "mongodb",
        "aliases": [
          "MongoDB",
          "mongodb",
          "mongosh",
          "Mongo Command Prompt"
        ],
        "extensions": [
          ".mongodb",
          ".mongosh"
        ],
        "configuration": "./syntaxes/mongodb-language-configuration.json"
      },
      {
        "id": "cmd",
        "aliases": [
          "Command Prompt",
          "cmd",
          "CMD"
        ],
        "extensions": [
          ".cmd",
          ".bat"
        ]
      },
      {
        "id": "wsl",
        "aliases": [
          "WSL (Linux)",
          "wsl",
          "Linux (WSL)",
          "Ubuntu (WSL)",
          "Bash (WSL)"
        ],
        "extensions": [
          ".wsl",
          ".sh"
        ]
      }
    ],
    "grammars": [
      {
        "language": "mysql",
        "scopeName": "source.mysql",
        "path": "./syntaxes/mysql.tmLanguage.json"
      },
      {
        "language": "mongodb",
        "scopeName": "source.mongodb",
        "path": "./syntaxes/mongodb.tmLanguage.json"
      },
      {
        "language": "postgres",
        "scopeName": "source.postgres",
        "path": "./syntaxes/postgres.tmLanguage.json"
      },
      {
        "language": "sqlite",
        "scopeName": "source.sqlite",
        "path": "./syntaxes/sqlite.tmLanguage.json"
      }
    ],
    "notebooks": [
      {
        "type": "anyinb",
        "displayName": "AnyINB Notebook",
        "selector": [
          {
            "filenamePattern": "*.anyinb"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "anyinb.configureConnection",
        "title": "AnyINB: Configure Database Connection",
        "icon": "$(database)"
      },
      {
        "command": "anyinb.quickConnect",
        "title": "AnyINB: Quick Connect to Database",
        "icon": "$(zap)"
      },
      {
        "command": "anyinb.newNotebook",
        "title": "AnyINB: New Notebook"
      },
      {
        "command": "anyinb.selectTheme",
        "title": "AnyINB: Select Output Color Theme",
        "icon": "$(paintcan)"
      },
      {
        "command": "anyinb.startPresentation",
        "title": "AnyINB: Start Presentation / Story Mode",
        "icon": "$(play)"
      },
      {
        "command": "anyinb.disconnectAll",
        "title": "AnyINB: Disconnect All Databases"
      }
    ],
    "configuration": {
      "title": "AnyINB",
      "properties": {
        "anyinb.outputTheme": {
          "type": "string",
          "default": "mongosh-terminal",
          "enum": [
            "mongosh-terminal",
            "dracula",
            "tokyo-night",
            "monokai",
            "one-dark",
            "nord",
            "github-dark",
            "solarized-dark"
          ],
          "enumDescriptions": [
            "Authentic mongosh / Command Prompt terminal (Black BG, White Keys, Green Strings)",
            "Classic Dracula Theme (Purple, Green, Cyan & Pink)",
            "Tokyo Night Theme (Deep Indigo, Soft Blue & Magenta)",
            "High-contrast Monokai Retro Theme (Green, Yellow, Orange & Magenta)",
            "Atom One Dark Theme (Slate BG, Green Strings, Blue Accents)",
            "Nordic Frost Theme (Arctic Blue, Snow White & Forest Green)",
            "GitHub Dark Theme (Official GitHub Dark Gray, Blue & Green)",
            "Solarized Dark Theme (Deep Teal, Yellow & Forest Green)"
          ],
          "description": "Visual color theme for notebook cell outputs (Command Prompt, Table, JSON, Console)."
        },
        "anyinb.maxOutputHeight": {
          "type": "number",
          "default": 450,
          "description": "Maximum height in pixels for scrollable cell output (set to 0 for unlimited height)."
        },
        "anyinb.fontSize": {
          "type": "number",
          "default": 13,
          "description": "Font size in pixels for code, tables, and terminal outputs."
        },
        "anyinb.enableSearch": {
          "type": "boolean",
          "default": true,
          "description": "Enable instant live search and filtering on all tabular query results."
        },
        "anyinb.enableCopyButtons": {
          "type": "boolean",
          "default": true,
          "description": "Show one-click Copy buttons on outputs (Copy Table, Copy JSON, Copy Text)."
        },
        "anyinb.pythonAutoPlot": {
          "type": "boolean",
          "default": true,
          "description": "Automatically capture and render Matplotlib/Seaborn plots directly in the cell output."
        },
        "anyinb.useDocker": {
          "type": "boolean",
          "default": false,
          "description": "If enabled, AnyINB will attempt to execute languages (like Python, Node.js) inside isolated Docker containers instead of the host machine."
        },
        "anyinb.runAllMode": {
          "type": "string",
          "default": "sequential",
          "enum": [
            "sequential",
            "concurrent"
          ],
          "enumDescriptions": [
            "Run cells one after another (safe for REPL languages that share state across cells)",
            "Run all cells at once in parallel (faster, but output may intermix for REPL languages)"
          ],
          "description": "Controls how 'Run All' executes cells — sequentially (one-by-one, default) or concurrently (all at once)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "ignorePatterns": [
      "out/**",
      "node_modules/**"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "mongodb": "^6.8.0",
    "mysql2": "^3.11.0",
    "pg": "^8.22.0",
    "picomatch": "^4.0.5",
    "sqlite3": "^6.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.4",
    "@types/sqlite3": "^3.1.11",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.29.0",
    "chai": "^6.2.2",
    "eslint": "^9.0.0",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "typescript": "^5.5.0"
  }
}
