{
  "name": "anyinb",
  "displayName": "AnyINB — Universal Interactive Notebook",
  "description": "Practice ANY language in interactive notebook cells. Databases, programming languages, shell, APIs — all in one .anyinb file.",
  "version": "0.2.0",
  "publisher": "xenon-dev",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Notebooks",
    "Programming Languages",
    "Education",
    "Data Science"
  ],
  "keywords": [
    "notebook",
    "interactive",
    "python",
    "javascript",
    "typescript",
    "go",
    "rust",
    "java",
    "c",
    "cpp",
    "sql",
    "mysql",
    "mongodb",
    "redis",
    "postgresql",
    "sqlite",
    "bash",
    "powershell",
    "http",
    "rest",
    "practice",
    "anyinb"
  ],
  "activationEvents": [
    "onNotebook:anyinb"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "postgres",
        "aliases": [
          "PostgreSQL",
          "postgres"
        ],
        "extensions": [
          ".sql",
          ".psql"
        ]
      },
      {
        "id": "sqlite",
        "aliases": [
          "SQLite",
          "sqlite"
        ],
        "extensions": [
          ".sql",
          ".sqlite"
        ]
      },
      {
        "id": "redis",
        "aliases": [
          "Redis",
          "redis"
        ],
        "extensions": [
          ".redis"
        ]
      },
      {
        "id": "graphql",
        "aliases": [
          "GraphQL",
          "graphql"
        ],
        "extensions": [
          ".graphql",
          ".gql"
        ]
      },
      {
        "id": "websocket",
        "aliases": [
          "WebSocket",
          "websocket"
        ],
        "extensions": [
          ".ws"
        ]
      }
    ],
    "notebooks": [
      {
        "type": "anyinb",
        "displayName": "AnyINB Notebook",
        "selector": [
          {
            "filenamePattern": "*.anyinb"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "anyinb.configureConnection",
        "title": "AnyINB: Configure Database Connection",
        "icon": "$(database)"
      },
      {
        "command": "anyinb.newNotebook",
        "title": "AnyINB: New Notebook"
      },
      {
        "command": "anyinb.disconnectAll",
        "title": "AnyINB: Disconnect All Databases"
      }
    ],
    "configuration": {
      "title": "AnyINB",
      "properties": {
        "anyinb.useDocker": {
          "type": "boolean",
          "default": false,
          "description": "If enabled, AnyINB will attempt to execute languages (like Python, Node.js) inside isolated Docker containers instead of the host machine."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "mongodb": "^6.8.0",
    "mysql2": "^3.11.0",
    "pg": "^8.22.0",
    "sqlite3": "^6.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.4",
    "@types/sqlite3": "^3.1.11",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.29.0",
    "chai": "^6.2.2",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "typescript": "^5.5.0"
  }
}
